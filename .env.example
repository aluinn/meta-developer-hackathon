# Copy this file to .env and fill in your own value. Never commit .env.
# MODEL_API_KEY is the name Meta's docs use (https://dev.meta.ai/docs/quickstart).
# Get your key from the Meta developer portal (dev.meta.ai) / the hackathon
# participant guide. Each person uses their own key.
MODEL_API_KEY=your-key-here

# Browser origins allowed to call the server (the web app). Comma-separated, no trailing slash.
# Default (if unset) is local development: http://localhost:5173,http://127.0.0.1:5173
# ALLOWED_ORIGINS=https://your-web-app.example.com

# Where the server stores scans. Default: server/scans. Set this to use a mounted disk on a host.
# SCANS_DIR=/var/data/scans
