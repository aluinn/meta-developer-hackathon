{
  "name": "room-world-web",
  "private": true,
  "version": "0.1.0",
  "description": "Room world web app: loads a world.json made from a room scan and lets you race through it or check clearances (three.js + Rapier).",
  "license": "MIT",
  "author": "Aluinn McDonald and Zac Beaumont",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aluinn/meta-developer-hackathon.git",
    "directory": "web"
  },
  "homepage": "https://github.com/aluinn/meta-developer-hackathon#readme",
  "bugs": {
    "url": "https://github.com/aluinn/meta-developer-hackathon/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "bench": "node scripts/bench-clearance.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/three": "^0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0"
  }
}
